<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Logel AS – Registrering av tapt inntjening</title>

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/se-app.js</script>
  <script src="https://www.gstatic.com/firebasejs/10.5.0/firebase-fireipt>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyXXXXXXX", // ← Sett inn din API-nøkkel
      authDomain: "logel-web.firebaseapp.com",
      projectId: "logel-web",
      storageBucket: "logel-web.appspot.com",
      messagingSenderId: "1234567890",
      appId: "1:1234567890:web:abcdef123456"
    };

    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
  </script>

  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #111;
      color: #fff;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #0f0;
      margin-bottom: 30px;
    }

    .form-block {
      background-color: #222;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 0 10px #0f0;
    }

    label {
      display: block;
      margin-top: 10px;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 8px;
      margin-top: 5px;
      background-color: #333;
      color: #fff;
      border: none;
    }

    button {
      margin-top: 15px;
      padding: 10px 20px;
      background-color: #0f0;
      color: #000;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }

    .status {
      margin-top: 10px;
      color: #0f0;
    }
  </style>
</head>
<body>

  <h1>Registrering av tapt inntjening</h1>

  <div id="form-container"></div>

  <script>
    const firms = [
      "Lefdal Installasjon AS",
      "Elektro kontakten AS",
      "Smart elektro AS",
      "Alt installasjon AS",
      "Billkvam & Fagerhaug AS"
    ];

    const container = document.getElementById("form-container");

    firms.forEach((firm, index) => {
      const block = document.createElement("div");
      block.className = "form-block";

      block.innerHTML = `
        <h2>${firm}</h2>
        <label for="amount${index}">Beløp (kr):</label>
        <input type="number" id="amount${index}" placeholder="f.eks. 120000">

        <label for="percent${index}">Prosent (%):</label>
        <input type="number" id="percent${index}" placeholder="f.eks. 15">

        <button onclick="saveData(${index})">Lagre</button>
        <div class="status" id="status${index}"></div>
      `;

      container.appendChild(block);
    });

    function saveData(index) {
      const amount = document.getElementById(`amount${index}`).value;
      const percent = document.getElementById(`percent${index}`).value;
      const firmId = `firm${index}`;

      db.collection("tapteInntekter").doc(firmId).set({
        amount: parseFloat(amount),
        percent: parseFloat(percent)
      }).then(() => {
        document.getElementById(`status${index}`).textContent = "✅ Lagret!";
      }).catch((error) => {
        document.getElementById(`status${index}`).textContent = "❌ Feil ved lagring.";
        console.error("Lagringsfeil:", error);
      });
    }
  </script>

</body>
</html>
